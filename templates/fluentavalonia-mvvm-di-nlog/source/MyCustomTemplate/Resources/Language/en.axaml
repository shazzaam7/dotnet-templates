<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">
    <!-- Add UI Strings Here -->
    <sys:String x:Key="MainWindow.Title">MyCustomTemplate</sys:String>

    <!-- MessageBox Strings -->
    <sys:String x:Key="MessageBox.Ok">OK</sys:String>
    <sys:String x:Key="MessageBox.Yes">Yes</sys:String>
    <sys:String x:Key="MessageBox.No">No</sys:String>
    <sys:String x:Key="MessageBox.Cancel">Cancel</sys:String>
</ResourceDictionary>
